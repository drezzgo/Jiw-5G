{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src/simulation",
    "outDir": ".phase1-build"
  },
  "include": [
    "src/simulation/**/*.ts"
  ],
  "exclude": [
    "src/simulation/**/*.test.ts",
    "src/simulation/__tests__/**/*"
  ]
}